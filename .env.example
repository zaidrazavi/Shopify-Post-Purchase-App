# Copy this file to `.env` and fill in real values. `.env` is gitignored —
# never commit real secrets. On Render, set these as environment variables in
# the service dashboard (not via a committed file).

# --- Database (Neon Postgres) ---
# Use the DIRECT (non-pooled) connection string: in the Neon "Connect" dialog,
# turn OFF "Connection pooling" (the host will NOT contain "-pooler").
# A pooled connection can break Prisma migrations.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# --- Shopify app credentials ---
# From the Partner Dashboard, or run `shopify app env show`.
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""

# Must match `application_url` in shopify.app.toml (your Render URL in prod).
SHOPIFY_APP_URL="https://shopify-post-purchase-app.onrender.com"

# Comma-separated OAuth scopes (must match shopify.app.toml).
SCOPES="read_products"
