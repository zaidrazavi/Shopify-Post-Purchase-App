// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// Merchant-configured post-purchase offer, one row per shop.
model OfferConfig {
  shop          String   @id
  enabled       Boolean  @default(false)
  // Selected offer product (variantId is the numeric id used by the changeset).
  productId     String?
  variantId     String?
  productTitle  String?
  productImage  String?
  productPrice  String? // cached real variant price, e.g. "600.00"
  productCompareAtPrice String? // cached variant compare-at price, if set
  // Pricing override: "none" | "percentage" | "fixed".
  // percentage -> discountValue is a percent off (0-100).
  // fixed      -> discountValue is the override price the buyer pays.
  discountType  String   @default("none")
  discountValue Float?
  // Copy shown on the offer page.
  headline      String   @default("Wait — one more thing!")
  description   String   @default("Add this to your order before you go.")
  // Urgency countdown (UI-only, resets per page load).
  countdownEnabled Boolean @default(false)
  countdownMinutes Int     @default(10)
  // Editable call-to-action labels.
  acceptButtonText  String @default("Add This Gift To My Order")
  declineButtonText String @default("I'd rather pay full price")

  // --- Downsell: a single fallback offer shown when the main offer is declined.
  // Same shape as the main offer (no countdown of its own).
  downsellEnabled       Boolean @default(false)
  downsellProductId     String?
  downsellVariantId     String?
  downsellProductTitle  String?
  downsellProductImage  String?
  downsellProductPrice  String?
  downsellProductCompareAtPrice String?
  downsellDiscountType  String  @default("none")
  downsellDiscountValue Float?
  downsellHeadline      String  @default("Hold on — how about this instead?")
  downsellDescription   String  @default("A smaller add-on at a special price.")
  downsellAcceptButtonText  String @default("Yes, Add This To My Order")
  downsellDeclineButtonText String @default("No thanks")

  // --- Style / branding (admin live-preview only for now; stored for future
  // storefront use). All nullable so existing rows are untouched by the migration.
  bannerBackgroundColor String? // urgency banner background, hex e.g. "#E3F9E5"
  bannerTextColor       String? // urgency banner text, hex
  bannerIconColor       String? // banner icon color, hex (icon shown when set)
  previewButtonColor    String? // admin-preview CTA button color, hex
  cardLayout            String? // "horizontal" | "vertical"

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Pre-purchase (cart/checkout-click) upsell popup, configured per shop.
// Completely separate from OfferConfig (post-purchase).
model PrePurchasePopupConfig {
  shop    String  @id
  enabled Boolean @default(false)

  // --- General (look & feel) ---
  fontFamily      String @default("system") // key into a safe web-font list
  fontColor       String @default("#1A1A2E")
  backgroundColor String @default("#FFFFFF")
  themeVariant    String @default("classic") // "classic" | "bold"
  cornerRadius    Int    @default(14)

  // --- Display conditions ---
  hideIfInCart Boolean @default(true) // hide if cart already has the upsell product

  // --- Incentive / messaging ---
  headlineEnabled      Boolean @default(true)
  headlineText         String  @default("Wait! Add this to your order")
  subheadlineEnabled   Boolean @default(true)
  subheadlineText      String  @default("A special one-time offer, just for you.")
  descriptionEnabled   Boolean @default(true)
  descriptionText      String  @default("This limited-time add-on is the perfect finishing touch for your order — grab it now before you check out.")
  countdownEnabled     Boolean @default(true)
  countdownMinutes     Int     @default(10)
  timerBackgroundColor String  @default("#F8C9C9")

  // --- Buy box (offered product) ---
  productId             String?
  variantId             String?
  productTitle          String?
  productImage          String?
  productPrice          String?
  productCompareAtPrice String?
  imageFit              String  @default("cover") // "cover" | "contain"
  imageSize             String  @default("medium") // "small" | "medium" | "large"
  showCompareAt         Boolean @default(true)
  showSavings           Boolean @default(true)

  // --- Buttons ---
  acceptButtonText    String @default("Add to my order")
  acceptButtonColor   String @default("#EF6E7B")
  declineButtonText   String @default("No thanks")
  declineButtonColor  String @default("#6D7175")
  closeButtonBehavior String @default("decline") // "decline" | "close"

  // --- OCU-parity additions (all nullable/additive; null = sensible default) ---
  selectorsColor            String? // variant selector accent, hex
  elementsColor             String? // misc UI elements (dividers/borders), hex
  inheritStoreFont          Boolean? // true = use the theme's font, ignore fontFamily
  layout                    String? // "media-left" | "media-right" | "media-top" | "text-only"
  allowSubscription         Boolean? // stored flag (subscribe flow deferred)
  hideIfCartHasSubscription Boolean? // hide popup if cart already has a subscription
  imageBorder               Boolean? // draw a border around the product image
  autoselectVariant         Boolean? // auto-pick the first available variant
  hideQuantitySelector      Boolean? // hide the qty control
  predefinedQuantity        Int? // fixed quantity added to cart
  discountType              String? // "none" | "percentage" | "fixed"
  discountValue             Float? // percent (0-100) or fixed override price
  acceptButtonHoverColor    String? // accept button hover color, hex
  declineButtonHoverColor   String? // decline button hover color, hex

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================================
// Phase 2: multi-funnel / multi-offer models.
// Adapted from RevLift's Supabase schema to Prisma + Shopify session auth:
//   - Tenancy is by `shop` (myshopify domain), NOT Supabase auth.users/UUID.
//   - No RLS / GRANT / DB triggers (tenancy enforced in app queries; timestamps
//     via Prisma @updatedAt). Money = Decimal(10,2); IDs = uuid().
// These sit ALONGSIDE the legacy OfferConfig / PrePurchasePopupConfig models
// above, which stay the source of truth until Phase 4.
// ============================================================================

// Per-shop tenant record + store-level settings.
model Store {
  shop String @id

  storeName        String?
  storeEmail       String?
  currency         String  @default("USD")
  isInternal       Boolean @default(false)
  currentPlan      String  @default("FREE")
  monthlyRevenue   Decimal @default(0) @db.Decimal(10, 2)
  shopifyShopId    String?
  ownerEmail       String?
  welcomeDismissed Boolean @default(false)

  // Store-level settings blobs. Nullable; default objects live in app code.
  prePurchaseSettings  Json?
  postPurchaseSettings Json?
  thankYouSettings     Json?

  funnels Funnel[]
  events  Event[]
  billing Billing[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A funnel groups offers of a given type for a shop.
model Funnel {
  id    String @id @default(uuid())
  shop  String
  store Store  @relation(fields: [shop], references: [shop], onDelete: Cascade)

  name              String    @default("New Funnel")
  type              String    @default("post-purchase") // pre-purchase | post-purchase | thank-you
  status            String    @default("draft")
  triggerType       String    @default("all-products")
  triggerValue      String?
  priority          Int       @default(0)
  abTestEnabled     Boolean   @default(false)
  variantBSplit     Int       @default(50)
  rolloutPercentage Int       @default(100)
  dateStart         DateTime?
  dateEnd           DateTime?
  customerTags      String[]  @default([])
  excludeProducts   String[]  @default([])

  offers Offer[]
  events Event[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shop])
  @@index([status])
}

// An individual offer within a funnel.
model Offer {
  id       String @id @default(uuid())
  funnelId String
  funnel   Funnel @relation(fields: [funnelId], references: [id], onDelete: Cascade)

  type        String  @default("upsell")
  section     String  @default("product-page")
  position    Int     @default(0)
  productId   String?
  variantId   String?
  headline    String  @default("Special Offer!")
  description String  @default("")
  buttonText  String  @default("Add to Order")
  declineText String  @default("No thanks")
  imageUrl    String?

  price          Decimal? @db.Decimal(10, 2)
  compareAtPrice Decimal? @db.Decimal(10, 2)
  discountType   String?
  discountValue  Decimal? @db.Decimal(10, 2)

  timerEnabled  Boolean @default(false)
  timerDuration Int     @default(15)
  timerMessage  String  @default("Offer expires in:")

  buttonColor     String @default("#EF4444")
  buttonTextColor String @default("#FFFFFF")
  textColor       String @default("#000000")

  badgeEnabled Boolean @default(false)
  badgeText    String  @default("Best Value")
  badgeColor   String  @default("#10b981")

  layout String @default("vertical")

  // Card design brought over from the old pre-purchase popup editor.
  backgroundColor String?
  cornerRadius    Int?

  // --- Exact pre-purchase popup parity (mirrors PrePurchasePopupConfig).
  // All nullable/additive; null = the old default. Reuses existing Offer columns
  // where they already match: headline←headlineText, description←descriptionText,
  // price←productPrice, compareAtPrice←productCompareAtPrice, discountType/Value,
  // buttonText←acceptButtonText, buttonColor←acceptButtonColor,
  // declineText←declineButtonText, textColor←fontColor, backgroundColor,
  // cornerRadius, layout, timerEnabled←countdownEnabled, timerDuration←countdownMinutes.
  headlineEnabled           Boolean? // old default true
  subheadlineEnabled        Boolean? // old default true
  subheadlineText           String?  // old default "A special one-time offer, just for you."
  descriptionEnabled        Boolean? // old default true
  timerBackgroundColor      String?  // old default "#F8C9C9"
  productTitle              String?  // picked product's title (shown in preview)
  imageFit                  String?  // "cover" | "contain"; old default "cover"
  imageSize                 String?  // "small" | "medium" | "large"; old default "medium"
  imageBorder               Boolean? // draw a border around the product image
  autoselectVariant         Boolean? // auto-pick the first available variant
  hideQuantitySelector      Boolean? // hide the qty control
  predefinedQuantity        Int?     // fixed quantity added to cart
  showCompareAt             Boolean? // old default true
  showSavings               Boolean? // old default true
  acceptButtonHoverColor    String?  // accept button hover color, hex
  declineButtonColor        String?  // old default "#6D7175"
  declineButtonHoverColor   String?  // decline button hover color, hex
  closeButtonBehavior       String?  // "decline" | "close"; old default "decline"
  hideIfInCart              Boolean? // old default true
  allowSubscription         Boolean? // stored flag (subscribe flow deferred)
  hideIfCartHasSubscription Boolean? // hide if cart already has a subscription
  inheritStoreFont          Boolean? // true = use the theme's font
  fontFamily                String?  // key into FONT_STACKS; old default "system"
  selectorsColor            String?  // variant selector accent, hex
  elementsColor             String?  // dividers/borders accent, hex
  themeVariant              String?  // "classic" | "bold"; old default "classic"

  // --- OCU-style post-purchase fields (Phase 6-1). All nullable/additive;
  // null = feature off / use default. Reuses existing columns where present:
  // badge←badgeEnabled/badgeText, buttons←buttonText/declineText, headline,
  // countdown←timerEnabled/timerDuration, discount/compareAtPrice/showCompareAt.
  // Subscription / variant-selector / quantity-stepper intentionally deferred.
  buttonsPosition    String?  // "stacked" | "side-by-side"
  uspEnabled         Boolean? // show USP / feature bullets
  uspItems           Json?    // array of { text, iconUrl? }
  trustBadgesEnabled Boolean? // show trust-badge images row
  trustBadgeImages   Json?    // array of image URLs
  showMoneySummary   Boolean? // show subtotal/total lines
  videoEnabled       Boolean? // show video-as-thumbnail block
  videoThumbnailUrl  String?  // thumbnail image for the video block
  videoLinkUrl       String?  // external video URL (opens out; no inline player)
  contentBlocks      Json?    // ordered blocks: [{ type, position, ...fields }]
  editorSettings     Json?    // OCU editor cosmetics (paddings, section bg colors,
  //                             badge color/position, image size/fit, hide lines,
  //                             text&video layout, etc.). Preview-authoritative;
  //                             the theme-locked live extension honors the subset
  //                             it can (see post-purchase-ui/src/index.jsx).

  impressions Int     @default(0)
  conversions Int     @default(0)
  revenue     Decimal @default(0) @db.Decimal(10, 2)

  variantBHeadline    String?
  variantBDescription String?
  variantBButtonText  String?
  variantBImpressions Int     @default(0)
  variantBConversions Int     @default(0)
  variantBRevenue     Decimal @default(0) @db.Decimal(10, 2)

  trafficSplit Int @default(100)

  events Event[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([funnelId])
}

// Analytics event. funnel/offer are nullable and SET NULL on delete so history
// survives funnel/offer removal.
model Event {
  id    String @id @default(uuid())
  shop  String
  store Store  @relation(fields: [shop], references: [shop], onDelete: Cascade)

  type       String
  funnelId   String?
  funnel     Funnel? @relation(fields: [funnelId], references: [id], onDelete: SetNull)
  offerId    String?
  offer      Offer?  @relation(fields: [offerId], references: [id], onDelete: SetNull)
  variantId  String?
  orderId    String?
  customerId String?
  revenue    Decimal? @db.Decimal(10, 2)
  metadata   Json?

  createdAt DateTime @default(now())

  @@index([shop, type, createdAt])
  @@index([funnelId])
  @@index([offerId])
  @@index([createdAt])
}

// Billing charge record per shop.
model Billing {
  id    String @id @default(uuid())
  shop  String
  store Store  @relation(fields: [shop], references: [shop], onDelete: Cascade)

  chargeId  String?
  plan      String
  amount    Decimal  @default(0) @db.Decimal(10, 2)
  status    String   @default("pending")
  billingOn DateTime @default(now())

  createdAt DateTime @default(now())

  @@index([shop])
}
