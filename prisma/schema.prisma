// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// Merchant-configured post-purchase offer, one row per shop.
model OfferConfig {
  shop          String   @id
  enabled       Boolean  @default(false)
  // Selected offer product (variantId is the numeric id used by the changeset).
  productId     String?
  variantId     String?
  productTitle  String?
  productImage  String?
  productPrice  String? // cached real variant price, e.g. "600.00"
  productCompareAtPrice String? // cached variant compare-at price, if set
  // Pricing override: "none" | "percentage" | "fixed".
  // percentage -> discountValue is a percent off (0-100).
  // fixed      -> discountValue is the override price the buyer pays.
  discountType  String   @default("none")
  discountValue Float?
  // Copy shown on the offer page.
  headline      String   @default("Wait — one more thing!")
  description   String   @default("Add this to your order before you go.")
  // Urgency countdown (UI-only, resets per page load).
  countdownEnabled Boolean @default(false)
  countdownMinutes Int     @default(10)
  // Editable call-to-action labels.
  acceptButtonText  String @default("Add This Gift To My Order")
  declineButtonText String @default("I'd rather pay full price")

  // --- Downsell: a single fallback offer shown when the main offer is declined.
  // Same shape as the main offer (no countdown of its own).
  downsellEnabled       Boolean @default(false)
  downsellProductId     String?
  downsellVariantId     String?
  downsellProductTitle  String?
  downsellProductImage  String?
  downsellProductPrice  String?
  downsellProductCompareAtPrice String?
  downsellDiscountType  String  @default("none")
  downsellDiscountValue Float?
  downsellHeadline      String  @default("Hold on — how about this instead?")
  downsellDescription   String  @default("A smaller add-on at a special price.")
  downsellAcceptButtonText  String @default("Yes, Add This To My Order")
  downsellDeclineButtonText String @default("No thanks")

  // --- Style / branding (admin live-preview only for now; stored for future
  // storefront use). All nullable so existing rows are untouched by the migration.
  bannerBackgroundColor String? // urgency banner background, hex e.g. "#E3F9E5"
  bannerTextColor       String? // urgency banner text, hex
  bannerIconColor       String? // banner icon color, hex (icon shown when set)
  previewButtonColor    String? // admin-preview CTA button color, hex
  cardLayout            String? // "horizontal" | "vertical"

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Pre-purchase (cart/checkout-click) upsell popup, configured per shop.
// Completely separate from OfferConfig (post-purchase).
model PrePurchasePopupConfig {
  shop    String  @id
  enabled Boolean @default(false)

  // --- General (look & feel) ---
  fontFamily      String @default("system") // key into a safe web-font list
  fontColor       String @default("#1A1A2E")
  backgroundColor String @default("#FFFFFF")
  themeVariant    String @default("classic") // "classic" | "bold"
  cornerRadius    Int    @default(14)

  // --- Display conditions ---
  hideIfInCart Boolean @default(true) // hide if cart already has the upsell product

  // --- Incentive / messaging ---
  headlineEnabled      Boolean @default(true)
  headlineText         String  @default("Wait! Add this to your order")
  subheadlineEnabled   Boolean @default(true)
  subheadlineText      String  @default("A special one-time offer, just for you.")
  descriptionEnabled   Boolean @default(true)
  descriptionText      String  @default("This limited-time add-on is the perfect finishing touch for your order — grab it now before you check out.")
  countdownEnabled     Boolean @default(true)
  countdownMinutes     Int     @default(10)
  timerBackgroundColor String  @default("#F8C9C9")

  // --- Buy box (offered product) ---
  productId             String?
  variantId             String?
  productTitle          String?
  productImage          String?
  productPrice          String?
  productCompareAtPrice String?
  imageFit              String  @default("cover") // "cover" | "contain"
  imageSize             String  @default("medium") // "small" | "medium" | "large"
  showCompareAt         Boolean @default(true)
  showSavings           Boolean @default(true)

  // --- Buttons ---
  acceptButtonText    String @default("Add to my order")
  acceptButtonColor   String @default("#EF6E7B")
  declineButtonText   String @default("No thanks")
  declineButtonColor  String @default("#6D7175")
  closeButtonBehavior String @default("decline") // "decline" | "close"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
